# Skyline Holding - production environment
#
# Copy to `.env` on the SERVER (never commit the real file):
#     cp .env.example .env && chmod 600 .env
# Values with spaces must be quoted. There are no real secrets in this file.
#
# One file drives both parts:
#   - the API (PM2 loads it via node --env-file, see ecosystem.config.cjs)
#   - the website build (scripts/deploy.sh reads SITE_URL for the canonical URL)

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=production

# Port and interface the API listens on. Keep HOST=127.0.0.1 so the API is only
# reachable through Nginx (do not open this port in the firewall).
PORT=8080
HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Public URL  <-- the ONE setting to change when the real domain is connected
# ---------------------------------------------------------------------------
# The production domain (no trailing slash). Before the domain and HTTPS are
# live you can temporarily use the server IP, e.g. http://2.25.169.72
# Used for: canonical URL / og:url in the website build (VITE_SITE_URL is
# derived from it by scripts/deploy.sh) and the API's CORS allow-list.
# Changing it needs a rebuild:  bash scripts/deploy.sh
SITE_URL=https://skyline-holding-slu.com

# Optional overrides (normally leave empty; both default to SITE_URL).
# CORS is not needed for the browser because the site and /api share one origin.
PUBLIC_SITE_URL=
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# OTP verification
# ---------------------------------------------------------------------------
# Secret used to HMAC OTP codes before they are stored. REQUIRED - the API
# refuses to start without it. Generate once on the server:  openssl rand -hex 32
OTP_HASH_SECRET=

# Minutes an OTP stays valid, and wrong attempts allowed per code.
REQUEST_INFO_OTP_TTL_MINUTES=10
REQUEST_INFO_MAX_ATTEMPTS=5

# Where pending OTP challenges are stored (JSON file). Must be writable by the
# user running PM2 and must survive deploys, so keep it OUTSIDE the project
# folder:   sudo install -d -o skyline -g skyline -m 700 /var/lib/skyline-holding
REQUEST_INFO_DATA_DIR=/var/lib/skyline-holding

# ---------------------------------------------------------------------------
# Email delivery (Resend) - REQUIRED in production
# ---------------------------------------------------------------------------
# In production the API refuses to start unless MAIL_PROVIDER=resend
# ("console" would print visitors' OTP codes to the server log).
MAIL_PROVIDER=resend
RESEND_API_KEY=
# Sender: emails go out as  Skyline Holding <info@skyline-holding-slu.com>
# and replies come back to the same address. MAIL_FROM_EMAIL must be the bare
# address (no display name, no <>); the name comes from MAIL_FROM_NAME.
# The domain skyline-holding-slu.com must be verified in the Resend account.
MAIL_FROM_EMAIL=info@skyline-holding-slu.com
MAIL_FROM_NAME="Skyline Holding"

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# trace | debug | info | warn | error
LOG_LEVEL=info
