# LOCAL DEVELOPMENT ONLY.
#
# The production configuration (every variable, with explanations) is the
# repository-root `.env.example`, used with DEPLOYMENT.md. Do not deploy this file.
#
# Run the API locally with (from artifacts/api-server):
#   pnpm run build && node --env-file=.env ./dist/index.mjs

PORT=8080

# Required in every environment: the API refuses to start without it.
# Any random string is fine locally.
OTP_HASH_SECRET=

# "console" prints emails (including the OTP code) to the server log instead of
# sending them. Local development only; production refuses to start with it.
MAIL_PROVIDER=console

# Optional, local defaults are fine:
# REQUEST_INFO_OTP_TTL_MINUTES=10
# REQUEST_INFO_MAX_ATTEMPTS=5
# REQUEST_INFO_DATA_DIR=.data
